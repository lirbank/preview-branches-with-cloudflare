{
  "compilerOptions": {
    "target": "es2024",
    "module": "es2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedSideEffectImports": true,
    "types": ["./worker-configuration.d.ts", "bun"]
  }
}
